# Copy this file to .env.local and set your local Redis URL.
# .env.local is git-ignored, so each developer keeps their own copy.
VITE_REDIS_URL=redis://default@127.0.0.1:6379

# Alternative: pass GROUPMQ_TEST_REDIS_URL in the shell to override without any file:
#   GROUPMQ_TEST_REDIS_URL=redis://default@127.0.0.1:6379 pnpm test
